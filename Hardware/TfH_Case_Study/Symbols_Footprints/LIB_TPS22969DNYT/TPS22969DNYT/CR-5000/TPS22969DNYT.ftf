(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r60_30
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 30000)
            (height 60000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r60_50
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 50000)
            (height 60000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r60_60
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 60000)
            (height 60000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r240_160
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 160000)
            (height 240000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r60_30
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r60_30))
          (noconnect (pad r60_30))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r60_30))
          (noconnect (pad r60_30))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r60_30))
          (noconnect (pad r60_30))
        )
      )
      (padstack r60_50
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r60_50))
          (noconnect (pad r60_50))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r60_50))
          (noconnect (pad r60_50))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r60_50))
          (noconnect (pad r60_50))
        )
      )
      (padstack r60_60
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r60_60))
          (noconnect (pad r60_60))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r60_60))
          (noconnect (pad r60_60))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r60_60))
          (noconnect (pad r60_60))
        )
      )
      (padstack r60_50
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r60_50))
          (noconnect (pad r60_50))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r60_50))
          (noconnect (pad r60_50))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r60_50))
          (noconnect (pad r60_50))
        )
      )
      (padstack r240_160
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r240_160))
          (noconnect (pad r240_160))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r240_160))
          (noconnect (pad r240_160))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r240_160))
          (noconnect (pad r240_160))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "TPS22969DNYT"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -150000 150000
                        (width 20000)
                      )
                      (pt 150000 150000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 150000 150000
                        (width 20000)
                      )
                      (pt 150000 -150000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 150000 -150000
                        (width 20000)
                      )
                      (pt -150000 -150000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -150000 -150000
                        (width 20000)
                      )
                      (pt -150000 150000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 269900 250000)
                    (pt 269900 -250000)
                    (pt -292300 -250000)
                    (pt -292300 250000)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -150000 150000
                        (width 10000)
                      )
                      (pt 150000 150000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -150000 -150000
                        (width 10000)
                      )
                      (pt 150000 -150000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -210000 97500
                        (width 20000)
                      )
                      (pt -210000 97500
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 10000)
                        (begin
                          (pt -210000 97500
                            (width 20000)
                          )
                        )
                        (center -1073741824 0)
                        (end
                          (pt -230000 97500
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 10000)
                        (begin
                          (pt -230000 97500
                            (width 20000)
                          )
                        )
                        (center 1073741824 0)
                        (end
                          (pt -210000 97500
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -140000 97500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -140000 97500)
                  (angle 90)
                  (padstackGroup default (padstack r60_30))
                )
              )
            )
          )
          (pin 2
            (pt -140000 32500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -140000 32500)
                  (angle 90)
                  (padstackGroup default (padstack r60_30))
                )
              )
            )
          )
          (pin 3
            (pt -140000 -32500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -140000 -32500)
                  (angle 90)
                  (padstackGroup default (padstack r60_30))
                )
              )
            )
          )
          (pin 4
            (pt -140000 -97500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -140000 -97500)
                  (angle 90)
                  (padstackGroup default (padstack r60_30))
                )
              )
            )
          )
          (pin 5
            (pt 139900 -97500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 139900 -97500)
                  (angle 90)
                  (padstackGroup default (padstack r60_30))
                )
              )
            )
          )
          (pin 6
            (pt 139900 -22500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 139900 -22500)
                  (angle 90)
                  (padstackGroup default (padstack r60_50))
                )
              )
            )
          )
          (pin 7
            (pt 139900 32500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 139900 32500)
                  (angle 90)
                  (padstackGroup default (padstack r60_60))
                )
              )
            )
          )
          (pin 8
            (pt 139900 87500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 139900 87500)
                  (angle 90)
                  (padstackGroup default (padstack r60_50))
                )
              )
            )
          )
          (pin 9
            (pt -0 -0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -0 -0)
                  (angle 0)
                  (padstackGroup default (padstack r240_160))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape TPS22969DNYT.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

